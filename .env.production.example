# Django settings
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=shikomba.me,www.shikomba.me
CSRF_TRUSTED_ORIGINS=https://shikomba.me,https://www.shikomba.me

# Django's MySQL connection. DB_PASSWORD and MYSQL_PASSWORD must match.
